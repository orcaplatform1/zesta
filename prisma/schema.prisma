// Zesta — tek mağazalı el işi e-ticaret veri modeli.
// Kaynak: /var/www/zesta.tr/mimari.pdf (bölüm 12 - Veritabanı).
// Kart bilgisi hiçbir tabloda tutulmuyor; Payment sadece sağlayıcı referansını saklar.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// KİMLİK
// ============================================================

enum AdminRole {
  SUPER_ADMIN
  STAFF
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         AdminRole @default(STAFF)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("admin_users")
}

// Hesap oluşturmak opsiyonel — misafir siparişi Order üzerinde customerId olmadan da var olabilir.
model Customer {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String?
  name         String
  phone        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  addresses     Address[]
  orders        Order[]
  reviews       Review[]
  carts         Cart[]
  couponUsages  CouponUsage[]

  @@map("customers")
}

model Address {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  label      String? // "Ev", "İş" vb.
  fullName   String
  phone      String
  city       String
  district   String
  postalCode String?
  addressLine String
  isDefault  Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@map("addresses")
}

// ============================================================
// KATALOG
// ============================================================

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  parentId    String?
  parent      Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryToCategory")
  products    Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("categories")
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  price       Decimal  @db.Decimal(10, 2)
  salePrice   Decimal? @db.Decimal(10, 2) // indirimli fiyat
  sku         String   @unique
  stock       Int      @default(0)
  weight      Decimal? @db.Decimal(10, 2) // gram
  productionTime String? // "Sipariş üzerine 3-5 iş günü"
  isActive    Boolean  @default(true)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  images     ProductImage[]
  variants   ProductVariant[]
  reviews    Review[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@map("products")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  position  Int     @default(0)

  @@index([productId])
  @@map("product_images")
}

// Örn: Renk = Mavi, Beden = M — basit ad/değer varyantı, stok ayrı takip edilebilir.
model ProductVariant {
  id         String  @id @default(cuid())
  productId  String
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name       String // "Renk"
  value      String // "Mavi"
  skuSuffix  String?
  stock      Int?
  priceDelta Decimal @default(0) @db.Decimal(10, 2)

  cartItems  CartItem[]
  orderItems OrderItem[]

  @@unique([productId, name, value])
  @@map("product_variants")
}

// ============================================================
// SEPET
// ============================================================

// Misafir sepeti cookie'deki sessionToken ile eşleşir; üye girişinde customerId'ye taşınır.
model Cart {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items        CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@map("carts")
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  quantity  Int
  unitPrice Decimal  @db.Decimal(10, 2) // eklendiği andaki fiyat

  createdAt DateTime @default(now())

  @@index([cartId])
  @@map("cart_items")
}

// ============================================================
// SİPARİŞ
// ============================================================

enum OrderStatus {
  PENDING
  PAID
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique // ORD-1024

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  // Misafir siparişi olabileceği için iletişim/adres bilgisi Order üzerinde de tutulur (snapshot).
  email       String
  phone       String
  fullName    String
  city        String
  district    String
  postalCode  String?
  addressLine String

  subtotal      Decimal @db.Decimal(10, 2)
  shippingCost  Decimal @default(0) @db.Decimal(10, 2)
  discountTotal Decimal @default(0) @db.Decimal(10, 2)
  total         Decimal @db.Decimal(10, 2)

  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)

  couponId String?
  coupon   Coupon? @relation(fields: [couponId], references: [id])

  items    OrderItem[]
  payment  Payment?
  shipment Shipment?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])

  productName String // snapshot — ürün sonradan değişse/silinse de sipariş geçmişi bozulmasın
  quantity    Int
  unitPrice   Decimal @db.Decimal(10, 2)
  totalPrice  Decimal @db.Decimal(10, 2)

  @@index([orderId])
  @@map("order_items")
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String        @unique
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider          String // "iyzico", "paytr" vb.
  providerPaymentId String?
  amount            Decimal       @db.Decimal(10, 2)
  currency          String        @default("TRY")
  status            PaymentStatus @default(PENDING)
  rawPayload        Json? // webhook denetimi için ham yanıt

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payments")
}

model Shipment {
  id             String    @id @default(cuid())
  orderId        String    @unique
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  carrier        String? // "Yurtiçi Kargo"
  trackingNumber String?
  shippedAt      DateTime?
  deliveredAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("shipments")
}

// ============================================================
// KAMPANYA
// ============================================================

enum DiscountType {
  PERCENT
  FIXED
  FREE_SHIPPING
}

model Coupon {
  id             String       @id @default(cuid())
  code           String       @unique
  discountType   DiscountType
  discountValue  Decimal      @default(0) @db.Decimal(10, 2)
  minCartAmount  Decimal?     @db.Decimal(10, 2)
  startsAt       DateTime?
  endsAt         DateTime?
  isActive       Boolean      @default(true)

  orders Order[]
  usages CouponUsage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("coupons")
}

model CouponUsage {
  id         String   @id @default(cuid())
  couponId   String
  coupon     Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  orderId    String
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  usedAt     DateTime @default(now())

  @@map("coupon_usages")
}

// ============================================================
// İÇERİK / DİĞER
// ============================================================

model Review {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  authorName String
  rating     Int // 1-5
  comment    String?
  isApproved Boolean  @default(false)

  createdAt DateTime @default(now())

  @@index([productId])
  @@map("reviews")
}

// Hakkımızda / Kargo & Teslimat / İade & Değişim / Gizlilik-KVKK gibi statik sayfalar.
model Page {
  id      String @id @default(cuid())
  slug    String @unique
  title   String
  content String @db.Text

  updatedAt DateTime @updatedAt

  @@map("pages")
}

model Setting {
  key   String @id
  value Json

  @@map("settings")
}
